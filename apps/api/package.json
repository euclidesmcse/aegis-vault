{
  "name": "@aegis/api",
  "version": "0.1.0",
  "description": "AegisVault API HTTP (Fastify).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/integration",
    "db:migrate": "tsx src/db/migrate.ts --up",
    "db:rollback": "tsx src/db/migrate.ts --down"
  },
  "dependencies": {
    "@aegis/config": "workspace:*",
    "@aegis/contracts": "workspace:*",
    "@aegis/authz": "workspace:*",
    "@aegis/crypto": "workspace:*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "pino": "^9.3.2",
    "postgres": "^3.4.4",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
