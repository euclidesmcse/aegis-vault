{
  "name": "@aegis/crypto",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node --experimental-strip-types --no-warnings --experimental-loader=../../scripts/loader-ts-as-js.mjs test/smoke.test.mjs",
    "test": "pnpm run test:smoke",
    "test:shim": "node --experimental-strip-types --no-warnings --experimental-loader=../../scripts/loader-ts-as-js.mjs test/shim-roundtrip.test.mjs",
    "test:real": "vitest run",
    "test:all": "pnpm run test:smoke && pnpm run test:shim && pnpm run test:real"
  },
  "dependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
