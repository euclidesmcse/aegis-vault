{$PRIMARY_DOMAIN} {
  encode zstd gzip
  reverse_proxy api:3001
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "accelerometer=(), geolocation=(), microphone=(), camera=()"
    Cross-Origin-Opener-Policy "same-origin"
    Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    -Server
  }
}
{$PRIMARY_DOMAIN}/api/v1 {
  reverse_proxy api:3001
}
