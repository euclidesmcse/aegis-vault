NODE_ENV=development
LOG_LEVEL=info
PRIMARY_DOMAIN=localhost
DATABASE_URL=postgres://aegis:aegis@postgres:5432/aegis
DATABASE_POOL_MAX=20
REDIS_URL=redis://redis:6379/0
BULLMQ_PREFIX=aegis:dev
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=aegis-attachments
S3_ACCESS_KEY=aegis-dev-access
S3_SECRET_KEY=aegis-dev-secret-change-me
S3_FORCE_PATH_STYLE=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="AegisVault <no-reply@localhost>"
SESSION_SECRET=replace-with-48-bytes-base64
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=1
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT=common
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/microsoft/callback
ENABLE_HIBP_K_ANON=true
HIBP_ENDPOINT=https://api.pwnedpasswords.com
